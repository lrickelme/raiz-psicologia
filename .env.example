# Copie para apps/api/.env
DATABASE_URL="postgresql://raiz:raiz@localhost:5433/raiz?schema=public"

# apps/web (Route Handler -> NestJS)
API_INTERNAL_URL="http://localhost:3333"

# Credencial única da profissional — lida por `pnpm seed`. Não há rota de
# cadastro; rodar o seed de novo redefine a senha.
RAIZ_EMAIL="profissional@exemplo.com"
RAIZ_SENHA="troque-esta-senha"
RAIZ_NOME="Nome da Profissional"

# Chave AES-256 da criptografia de coluna (dado clínico, ex.: motivo do
# atendimento). 32 bytes em base64 — gere com `openssl rand -base64 32`.
# Obrigatória: sem ela a API não sobe. Guarde fora do repositório; perder a
# chave torna ilegível tudo o que foi cifrado com ela.
RAIZ_CHAVE_CRIPTOGRAFIA=""

# Piso de tempo das recusas de login, em ms. Impede que o tempo de resposta
# distinga e-mail inexistente de senha incorreta; precisa ficar acima do p99
# real do Argon2 na máquina. Não afeta o login válido. Opcional, padrão 600.
RAIZ_LOGIN_PISO_MS="600"
