generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(uuid(7)) @db.Uuid
  email     String   @unique
  senhaHash String   @map("senha_hash")
  nome      String
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz
  sessoes   Sessao[]

  @@map("usuario")
}

/// Sessão de login (a consulta clínica é `Atendimento`, ver design.md).
/// O cookie carrega um token aleatório; a tabela guarda só o SHA-256 dele,
/// então um vazamento do banco não entrega sessões vivas.
model Sessao {
  id        String   @id @default(uuid(7)) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiraEm  DateTime @map("expira_em") @db.Timestamptz
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz

  @@index([expiraEm])
  @@map("sessao")
}
