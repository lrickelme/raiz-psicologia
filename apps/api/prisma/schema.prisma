generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(uuid(7)) @db.Uuid
  email     String   @unique
  senhaHash String   @map("senha_hash")
  nome      String
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz
  sessoes   Sessao[]

  @@map("usuario")
}

/// Sessão de login (a consulta clínica é `Atendimento`, ver design.md).
/// O cookie carrega um token aleatório; a tabela guarda só o SHA-256 dele,
/// então um vazamento do banco não entrega sessões vivas.
model Sessao {
  id        String   @id @default(uuid(7)) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiraEm  DateTime @map("expira_em") @db.Timestamptz
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz

  @@index([expiraEm])
  @@map("sessao")
}

/// Trilha de auditoria (spec auth, "Trilha de auditoria"). Somente-inserção:
/// a migration revoga UPDATE/DELETE/TRUNCATE e um gatilho recusa as três
/// operações até para o dono da tabela. `tipoEvento` é texto, não enum, para
/// que um evento novo não exija migration — os valores vivem em
/// `auditoria/eventos.ts`.
model Auditoria {
  id          String   @id @default(uuid(7)) @db.Uuid
  ocorridoEm  DateTime @default(now()) @map("ocorrido_em") @db.Timestamptz
  tipoEvento  String   @map("tipo_evento")
  recursoTipo String?  @map("recurso_tipo")
  recursoId   String?  @map("recurso_id")
  ip          String?
  detalhe     Json     @default("{}")

  @@index([ocorridoEm])
  @@index([recursoTipo, recursoId])
  @@map("auditoria")
}

enum StatusPaciente {
  ATIVO
  ARQUIVADO
}

/// Paciente nunca é excluído, só arquivado (spec pacientes). A busca por nome
/// e telefone usa índices de expressão (`unaccent` + `pg_trgm`) criados na
/// migration, que o Prisma não modela — ver `paciente.repository.ts`.
model Paciente {
  id                  String             @id @default(uuid(7)) @db.Uuid
  nome                String
  telefone            String?
  email               String?
  nascimento          DateTime?          @db.Date
  valorConsultaPadrao Decimal            @map("valor_consulta_padrao") @db.Decimal(10, 2)
  observacoes         String?
  status              StatusPaciente     @default(ATIVO)
  criadoEm            DateTime           @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm        DateTime           @updatedAt @map("atualizado_em") @db.Timestamptz
  atendimentos        Atendimento[]
  evolucoes           Evolucao[]
  rascunhos           RascunhoEvolucao[]

  @@index([status])
  @@map("paciente")
}

enum StatusAtendimento {
  AGENDADO
  REALIZADO
  CANCELADO
  REMARCADO
  FALTA
}

/// A consulta clínica (design.md: `Sessao` é a sessão de login). Um só registro
/// por ciclo de vida, exceto na remarcação, que encerra este e cria outro
/// apontando para ele. Constraints que o Prisma não modela — `EXCLUDE` contra
/// sobreposição, duração, motivo obrigatório nos encerramentos — estão na
/// migration `atendimento`.
model Atendimento {
  id                 String             @id @default(uuid(7)) @db.Uuid
  pacienteId         String             @map("paciente_id") @db.Uuid
  paciente           Paciente           @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  inicio             DateTime           @db.Timestamptz
  fim                DateTime           @db.Timestamptz
  status             StatusAtendimento  @default(AGENDADO)
  /// Congelado no agendamento: reajuste do paciente não retroage (spec pacientes).
  valor              Decimal            @db.Decimal(10, 2)
  /// Dado clínico, cifrado pela extensão `comum/criptografia`.
  motivo             String?
  /// Único: um atendimento é substituído no máximo uma vez.
  remarcadoDeId      String?            @unique @map("remarcado_de_id") @db.Uuid
  remarcadoDe        Atendimento?       @relation("Remarcacao", fields: [remarcadoDeId], references: [id], onDelete: Restrict)
  remarcadoPara      Atendimento?       @relation("Remarcacao")
  /// Instante da transição para CANCELADO, REMARCADO, FALTA ou REALIZADO,
  /// gravado no mesmo UPDATE que muda o status. Nulo enquanto AGENDADO.
  encerradoEm        DateTime?          @map("encerrado_em") @db.Timestamptz
  /// Congelado no encerramento por `comum/cobranca` (spec agenda,
  /// "Cobrabilidade congelada no encerramento"). Nulo enquanto AGENDADO — e,
  /// para cancelamento antigo sem registro na trilha, até decisão da profissional.
  cobravel           Boolean?
  cobrancaDispensada Boolean            @default(false) @map("cobranca_dispensada")
  /// Dado clínico ou pessoal, cifrado pela extensão `comum/criptografia`.
  motivoDispensa     String?            @map("motivo_dispensa")
  evolucoes          Evolucao[]
  rascunhos          RascunhoEvolucao[]
  criadoEm           DateTime           @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm       DateTime           @updatedAt @map("atualizado_em") @db.Timestamptz

  @@index([inicio])
  @@index([pacienteId, inicio])
  @@map("atendimento")
}

/// Registro clínico (spec prontuario). Nunca editado nem excluído: retificar
/// encerra esta versão (`vigente = false`) e cria outra apontando para ela,
/// como na remarcação de atendimento. Um gatilho na migration `evolucao`
/// recusa DELETE e qualquer UPDATE além de encerrar a versão vigente.
model Evolucao {
  id            String       @id @default(uuid(7)) @db.Uuid
  pacienteId    String       @map("paciente_id") @db.Uuid
  paciente      Paciente     @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  atendimentoId String?      @map("atendimento_id") @db.Uuid
  atendimento   Atendimento? @relation(fields: [atendimentoId], references: [id], onDelete: Restrict)
  /// Dado clínico, cifrado pela extensão `comum/criptografia`.
  texto         String
  /// Hora do servidor na gravação; nenhum DTO aceita este campo.
  registradoEm  DateTime     @default(now()) @map("registrado_em") @db.Timestamptz
  /// Único: uma versão é retificada no máximo uma vez.
  retificaDeId  String?      @unique @map("retifica_de_id") @db.Uuid
  retificaDe    Evolucao?    @relation("Retificacao", fields: [retificaDeId], references: [id], onDelete: Restrict)
  retificadaPor Evolucao?    @relation("Retificacao")
  vigente       Boolean      @default(true)
  criadoEm      DateTime     @default(now()) @map("criado_em") @db.Timestamptz

  @@index([pacienteId, registradoEm])
  @@index([atendimentoId])
  @@map("evolucao")
}

/// Texto em edição, salvo no servidor para não se perder (spec prontuario,
/// "Rascunho sem perda"). Não é registro clínico: não entra no PDF nem na
/// guarda, e é apagado quando a evolução correspondente é gravada. A
/// unicidade trata `atendimentoId` nulo como valor (`NULLS NOT DISTINCT`, na
/// migration), para que o rascunho avulso também seja um só por paciente.
model RascunhoEvolucao {
  id            String       @id @default(uuid(7)) @db.Uuid
  pacienteId    String       @map("paciente_id") @db.Uuid
  paciente      Paciente     @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  atendimentoId String?      @map("atendimento_id") @db.Uuid
  atendimento   Atendimento? @relation(fields: [atendimentoId], references: [id], onDelete: Restrict)
  /// Cifrado como a evolução: texto clínico, ainda que provisório.
  texto         String
  atualizadoEm  DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz

  @@unique([pacienteId, atendimentoId])
  @@map("rascunho_evolucao")
}

enum StatusTopico {
  A_ESTUDAR
  EM_ESTUDO
  CONCLUIDO
}

/// Papel de cor do Raíz, nunca hex: o par fundo/texto vive no front (spec
/// estudos, "Paleta fechada de cores").
enum CorLabel {
  VINHO
  AMBAR
  MUSGO
  MUSGO_SUAVE
  MARROM
  BEGE
}

/// Prioridade de tópico de estudo. A `ordem` (1..n, sem buracos) é que define a
/// prioridade, não o nome. Sem `UNIQUE` na ordem: a reordenação sempre reescreve
/// a lista inteira numa transação (design.md da 04). O nome é único por
/// `raiz_normalizar`, índice de expressão criado na migration `estudos`.
model LabelPrioridade {
  id           String         @id @default(uuid(7)) @db.Uuid
  nome         String
  cor          CorLabel
  ordem        Int
  topicos      TopicoEstudo[]
  criadoEm     DateTime       @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz

  @@map("label_prioridade")
}

/// Tópico de estudo. Não é dado de paciente: sem cifra e sem auditoria. Nunca
/// excluído; a conclusão encerra o ciclo. O `CHECK topico_conclusao_coerente` da
/// migration garante `concluidoEm` se, e somente se, `CONCLUIDO`.
model TopicoEstudo {
  id           String           @id @default(uuid(7)) @db.Uuid
  titulo       String
  descricao    String?
  labelId      String?          @map("label_id") @db.Uuid
  label        LabelPrioridade? @relation(fields: [labelId], references: [id], onDelete: Restrict)
  status       StatusTopico     @default(A_ESTUDAR)
  /// Hora do servidor na conclusão; nenhum DTO aceita este campo.
  concluidoEm  DateTime?        @map("concluido_em") @db.Timestamptz
  criadoEm     DateTime         @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz

  @@index([status])
  @@map("topico_estudo")
}
